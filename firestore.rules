rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get user profile details from the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if the logged-in user is an Admin
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'admin@nativebooking.co' || getUserData().role == 'admin');
    }

    // Helper: Check if the logged-in user owns the document/data
    function isOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // --- USERS COLLECTION RULES ---
    match /users/{userId} {
      // Users can only read/write their own profiles; Admins can read all profiles.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- BOOKINGS COLLECTION RULES ---
    match /bookings/{bookingId} {
      // Any authenticated user can read bookings (filtered client-side by email)
      allow read: if isSignedIn();
      // Any authenticated user can create a booking
      allow create: if isSignedIn();
      // Only the booking owner or an admin can update/delete
      allow update, delete: if isSignedIn() && 
        (isAdmin() || isOwner(resource.data.ownerEmail));
    }

    // --- NOTIFICATIONS COLLECTION RULES ---
    match /notifications/{notificationId} {
      // Only admins can read notifications
      allow read: if isSignedIn() && isAdmin();
      // Any authenticated user can create notifications (e.g. booking triggers)
      allow create: if isSignedIn();
      // Only admins can update/delete notifications
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // --- INTRO CALL BOOKINGS COLLECTION RULES ---
    match /intro_call_bookings/{callId} {
      // Admins can read all intro call bookings
      allow read: if isSignedIn() && isAdmin();
      // Anyone can create an intro call request (public form)
      allow create: if true;
      // Only admins can update/delete
      allow update, delete: if isSignedIn() && isAdmin();
    }
  }
}
