rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get user profile details from the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if the logged-in user is an Admin
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'admin@test.com' || getUserData().role == 'admin');
    }

    // Helper: Check if the logged-in user owns the document/data
    function isOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // --- USERS COLLECTION RULES ---
    match /users/{userId} {
      // Users can only read/write their own profiles; Admins can read all profiles.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- BOOKINGS COLLECTION RULES ---
    match /bookings/{bookingId} {
      // Admins have full access. Customers can read and write only their own bookings.
      allow read: if isAdmin() || (isSignedIn() && isOwner(resource.data.customerEmail));
      
      // Allow creation if the booking email matches the logged-in user's email, or if user is admin
      allow create: if isAdmin() || (isSignedIn() && isOwner(request.resource.data.customerEmail));
      
      // Allow updates if the existing booking belongs to the user, or if user is admin
      allow update: if isAdmin() || (isSignedIn() && isOwner(resource.data.customerEmail));
      
      // Allow deletion only by Admins
      allow delete: if isAdmin();
    }

    // --- NOTIFICATIONS COLLECTION RULES ---
    match /notifications/{notificationId} {
      // Notifications are admin-only
      allow read, write: if isAdmin();
    }
  }
}
