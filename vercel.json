{
  "rewrites": [
    {
      "source": "/faraon",
      "destination": "/public/faraon/index.html"
    },
    {
      "source": "/faraon/",
      "destination": "/public/faraon/index.html"
    },
    {
      "source": "/faraon/(.*)",
      "destination": "/public/faraon/$1"
    },
    {
      "source": "/((?!assets/|public/|faraon/).*)",
      "destination": "/index.html"
    }
  ]
}
